{
  "Urls": "http://0.0.0.0:5200",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "Gateway": {
    "ApiKey": "change-me-gateway-key",
    "AgentTimeoutSeconds": 120,
    "MaxTextDiffBytes": 5000000,
    "MaxDiffLines": 2000,
    "Servers": [
      {
        "Id": "srv1",
        "Name": "Server 1"
      },
      {
        "Id": "srv2",
        "Name": "Server 2"
      },
      {
        "Id": "srv3",
        "Name": "Server 3"
      },
      {
        "Id": "srv4",
        "Name": "Server 4"
      }
    ],
    "Sets": [
      {
        "Id": "web-tier",
        "Name": "Web tier",
        "ServerIds": [
          "srv1",
          "srv2",
          "srv3",
          "srv4"
        ],
        "Paths": [
          {
            "Path": "web/bin",
            "Recursive": true,
            "Include": [
              "*.dll",
              "*.exe"
            ],
            "Exclude": [
              "*.pdb"
            ]
          },
          {
            "Path": "web/wwwroot",
            "Recursive": true,
            "ExcludeFolders": [
              "node_modules",
              ".git"
            ]
          },
          {
            "Path": "config/appsettings.json"
          }
        ]
      }
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "agent-srv1": {
        "ClusterId": "agent-srv1",
        "Match": {
          "Path": "/agents/srv1/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/agents/srv1"
          },
          {
            "RequestHeader": "X-Api-Key",
            "Set": "change-me-agent-key"
          }
        ]
      },
      "agent-srv2": {
        "ClusterId": "agent-srv2",
        "Match": {
          "Path": "/agents/srv2/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/agents/srv2"
          },
          {
            "RequestHeader": "X-Api-Key",
            "Set": "change-me-agent-key"
          }
        ]
      },
      "agent-srv3": {
        "ClusterId": "agent-srv3",
        "Match": {
          "Path": "/agents/srv3/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/agents/srv3"
          },
          {
            "RequestHeader": "X-Api-Key",
            "Set": "change-me-agent-key"
          }
        ]
      },
      "agent-srv4": {
        "ClusterId": "agent-srv4",
        "Match": {
          "Path": "/agents/srv4/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/agents/srv4"
          },
          {
            "RequestHeader": "X-Api-Key",
            "Set": "change-me-agent-key"
          }
        ]
      }
    },
    "Clusters": {
      "agent-srv1": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "3"
        },
        "HttpRequest": {
          "ActivityTimeout": "00:02:00"
        },
        "Destinations": {
          "agent": {
            "Address": "http://server1:5300/"
          }
        }
      },
      "agent-srv2": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "3"
        },
        "HttpRequest": {
          "ActivityTimeout": "00:02:00"
        },
        "Destinations": {
          "agent": {
            "Address": "http://server2:5300/"
          }
        }
      },
      "agent-srv3": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "3"
        },
        "HttpRequest": {
          "ActivityTimeout": "00:02:00"
        },
        "Destinations": {
          "agent": {
            "Address": "http://server3:5300/"
          }
        }
      },
      "agent-srv4": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "3"
        },
        "HttpRequest": {
          "ActivityTimeout": "00:02:00"
        },
        "Destinations": {
          "agent": {
            "Address": "http://server4:5300/"
          }
        }
      }
    }
  }
}
